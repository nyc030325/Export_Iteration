  (h_g3_lim : Filter.Tendsto (iteratedDeriv 3 g) Filter.atTop (nhds 0))
  (h_phi_neg_zero : phi 0 < 0)
  (h_phi_pos_inf : ∃ L, ∀ x > L, phi x > 0) :
  ∃ x₁ > 0, (∀ x ∈ Set.Ico 0 x₁, iteratedDeriv 4 f x < 0) ∧ 
